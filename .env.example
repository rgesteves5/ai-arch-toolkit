# Provider API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
# Meta Model API (Muse Spark) — Meta's own variable name
MODEL_API_KEY=

# Optional tool keys: a tool that finds one sends it; without it, the tool works within the
# service's anonymous limit.
# SEMANTIC_SCHOLAR_API_KEY=   # free: https://www.semanticscholar.org/product/api#api-key-form
# Web search tools (each search is billed; both have a free monthly allowance):
# BRAVE_SEARCH_API_KEY=       # https://brave.com/search/api/
# TAVILY_API_KEY=             # https://app.tavily.com

# Optional runtime configuration
AI_ARCH_SYNC_TIMEOUT=300
AI_ARCH_STREAM_JOIN_TIMEOUT=5
